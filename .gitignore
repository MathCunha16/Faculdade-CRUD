# ===============================================================
# Arquivos de Log e Cache
# Ignora arquivos de log e cache de várias ferramentas
# ===============================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*


# ===============================================================
# Backend - Java / Maven / Spring Boot
# ===============================================================
# A pasta 'target' contém os arquivos compilados (.class) e o .jar final.
# Ela é sempre gerada a partir do código fonte.
/backend/target/

# Arquivos de configuração específicos do Eclipse
/backend/.classpath
/backend/.project
/backend/.settings/
/backend/bin/

# Arquivos gerados pelo Spring Tool Suite (STS)
.apt_generated
.factorypath
.springBeans
.sts4-cache


# ===============================================================
# Frontend - JavaScript / Node.js / Vite / React
# ===============================================================
# A pasta node_modules contém todas as bibliotecas baixadas.
# Ela é recriada com 'npm install' e pode ter milhares de arquivos.
/frontend/node_modules/

# A pasta 'dist' é a versão de produção do seu site, gerada com 'npm run build'.
/frontend/dist/

# Arquivos de ambiente locais que contêm senhas e chaves de API. NUNCA devem ir para o repositório.
.env
.env.local
.env.*.local

# Relatórios de teste e cobertura de código
/frontend/coverage/


# ===============================================================
# Arquivos de IDEs (IntelliJ, VSCode, etc.)
# =iy=============================================================
# IntelliJ
.idea/
*.iml
*.iws

# VSCode
.vscode/


# ===============================================================
# Arquivos de Sistema Operacional
# ===============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db